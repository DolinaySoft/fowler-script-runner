<Project Sdk="Microsoft.NET.Sdk">

  <!-- automaticke testy spoustece: synteticke skripty (konstanty, zadne hodnoceni) a vzorova data z priklady/;
       nejsou soucasti releasu -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Spoustec.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.5.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Spoustec\Spoustec.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\priklady\**\*.json;..\..\priklady\**\*.js" LinkBase="priklady" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- testy spoustene jako proces potrebuji spoustec.exe i s jeho .config (presmerovani verzi knihoven) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SpoustecExe</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\Spoustec\bin\$(Configuration)\net48\spoustec.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
